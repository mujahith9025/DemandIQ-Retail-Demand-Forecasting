# ==========================================
# DemandIQ - Environment Configuration Guide
# ==========================================

# --- Core Service Settings ---
APP_NAME=DemandIQ
ENVIRONMENT=production                 # development | staging | production
DEBUG=False                            # Set False in production
VERSION=1.0.0

# --- Server & Networking ---
HOST=0.0.0.0
PORT=8000
BACKEND_URL=https://api.demandiq.io
FRONTEND_URL=https://app.demandiq.io

# --- Database & Storage (PostgreSQL) ---
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://demandiq_admin:SuperSecurePassword123!@db-cluster.demandiq.internal:5432/demandiq_production
POSTGRES_USER=demandiq_admin
POSTGRES_PASSWORD=SuperSecurePassword123!
POSTGRES_DB=demandiq_production
POSTGRES_PORT=5432

# --- Security & JWT Authentication ---
# Generate using: openssl rand -hex 32
SECRET_KEY=e4f9b2d9213812a8492048102948210482910482019482019482019482019482
ACCESS_TOKEN_EXPIRE_MINUTES=60        # 1 Hour Access Token
REFRESH_TOKEN_EXPIRE_DAYS=7           # 7 Days Refresh Token

# --- CORS Allowed Origins ---
# JSON array of origins permitted to make cross-origin requests
CORS_ORIGINS=["https://app.demandiq.io","https://staging.demandiq.io","http://localhost:3000"]

# --- ML & Model Storage ---
MODEL_STORAGE_PATH=/app/app/ml/saved_models
DEFAULT_FORECAST_HORIZON_WEEKS=4
COLD_START_MIN_HISTORY_WEEKS=8

# --- Logging & Observability ---
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
ENABLE_STRUCTURED_JSON_LOGGING=True

# --- Frontend Client Configuration ---
NEXT_PUBLIC_API_URL=https://api.demandiq.io
