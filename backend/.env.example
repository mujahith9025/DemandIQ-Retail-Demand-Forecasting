# Application Configuration
APP_NAME=DemandIQ
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=True

# Database Connection (PostgreSQL)
# For Docker Compose: postgresql://demandiq:demandiq_secret@postgres:5432/demandiq_db
# For Local Dev without Docker: postgresql://demandiq:demandiq_secret@localhost:5432/demandiq_db
# Or SQLite fallback for local test: sqlite:///./demandiq.db
DATABASE_URL=postgresql://demandiq:demandiq_secret@localhost:5432/demandiq_db

# Security & Authentication
SECRET_KEY=change_this_to_a_very_secure_random_key_in_production_32_chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS Origins (JSON string array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
